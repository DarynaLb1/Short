import ccxt
import time
from datetime import datetime, timedelta
import logging
import sys
import os
from typing import Dict, Optional, Union
import json
from pathlib import Path

# Setup logging with rotation
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.handlers.RotatingFileHandler(
            'mexc_short_bot.log',
            maxBytes=10*1024*1024,  # 10MB
            backupCount=5
        ),
        logging.StreamHandler(sys.stdout)
    ]
)
logger = logging.getLogger(__name__)

class Config:
    """Configuration class with environment variable support and validation"""
    API_KEY = os.getenv('MEXC_API_KEY')
    API_SECRET = os.getenv('MEXC_API_SECRET')
    SYMBOL = os.getenv('MEXC_SYMBOL', 'BTC_USDT')
    MARGIN = float(os.getenv('MEXC_MARGIN', '1000'))
    LEVERAGE = int(os.getenv('MEXC_LEVERAGE', '10'))
    PURCHASE_HOUR = int(os.getenv('MEXC_PURCHASE_HOUR', '15'))
    STOP_LOSS_PERCENT = float(os.getenv('MEXC_STOP_LOSS', '5.0'))
    TAKE_PROFIT_PERCENT = float(os.getenv('MEXC_TAKE_PROFIT', '10.0'))  # New feature
    RETRY_DELAY = int(os.getenv('MEXC_RETRY_DELAY', '300'))
    MAX_RETRIES = int(os.getenv('MEXC_MAX_RETRIES', '3'))

    @classmethod
    def validate(cls):
        """Validate configuration parameters"""
        if not cls.API_KEY or not cls.API_SECRET:
            raise ValueError("API_KEY and API_SECRET must be set")
        if cls.LEVERAGE < 1 or cls.LEVERAGE > 400:
            raise ValueError("LEVERAGE must be between 1 and 400")
        if cls.PURCHASE_HOUR < 0 or cls.PURCHASE_HOUR > 23:
            raise ValueError("PURCHASE_HOUR must be between 0 and 23")
        if cls.MARGIN <= 0:
            raise ValueError("MARGIN must be positive")
        if cls.STOP_LOSS_PERCENT <= 0:
            raise ValueError("STOP_LOSS_PERCENT must be positive")

class ShortBot:
    def __init__(self):
        """Initialize the trading bot"""
        self.config = Config()
        Config.validate()
        self.exchange = ccxt.mexc({
            'apiKey': self.config.API_KEY,
            'secret': self.config.API_SECRET,
            'enableRateLimit': True,
            'options': {'defaultType': 'future'}
        })
        self.position_file = Path('open_position.json')
        self.load_markets()
        self.set_leverage()

    def load_markets(self) -> None:
        """Load market data with retry logic"""
        for attempt in range(self.config.MAX_RETRIES):
            try:
                self.exchange.load_markets()
                if self.config.SYMBOL not in self.exchange.markets:
                    raise ValueError(f"Invalid symbol: {self.config.SYMBOL}")
                return
            except Exception as e:
                logger.error(f"Market load attempt {attempt + 1} failed: {e}")
                if attempt == self.config.MAX_RETRIES - 1:
                    sys.exit(1)
                time.sleep(self.config.RETRY_DELAY)

    def set_leverage(self) -> None:
        """Set leverage for the symbol"""
        try:
            response = self.exchange.private_post_futures_leverage({
                'symbol': self.config.SYMBOL,
                'leverage': self.config.LEVERAGE
            })
            if response.get('success', False):
                logger.info(f"Leverage set to {self.config.LEVERAGE}x for {self.config.SYMBOL}")
            else:
                raise ValueError("Leverage setting failed")
        except Exception as e:
            logger.error(f"Error setting leverage: {e}")
            sys.exit(1)

    def get_next_purchase_time(self) -> datetime:
        """Calculate next purchase time with timezone awareness"""
        now = datetime.utcnow()
        target = now.replace(hour=self.config.PURCHASE_HOUR, minute=0, second=0, microsecond=0)
        if now >= target:
            target += timedelta(days=1)
        return target

    def check_balance(self) -> Optional[float]:
        """Check and return available USDT balance"""
        try:
            balance = self.exchange.fetch_balance({'type': 'future'})
            usdt_balance = float(balance['total'].get('USDT', 0))
            required = self.config.MARGIN * 1.1
            if usdt_balance < required:
                logger.error(f"Insufficient balance: {usdt_balance:.2f} USDT, "
                           f"required: {required:.2f} USDT")
                return None
            return usdt_balance
        except Exception as e:
            logger.error(f"Balance check failed: {e}")
            return None

    def save_position(self, order: Dict) -> None:
        """Save position details to file with error handling"""
        try:
            position_data = {
                'order_id': order['id'],
                'symbol': self.config.SYMBOL,
                'amount': order['amount'],
                'price': order['price'],
                'timestamp': order['timestamp'],
                'stop_loss': order.get('stop_loss_price'),
                'take_profit': order.get('take_profit_price')
            }
            self.position_file.write_text(json.dumps(position_data))
        except Exception as e:
            logger.error(f"Failed to save position: {e}")

    def open_short(self) -> bool:
        """Open short position with stop-loss and take-profit"""
        balance = self.check_balance()
        if not balance:
            return False

        try:
            ticker = self.exchange.fetch_ticker(self.config.SYMBOL)
            current_price = ticker['last']
            position_size = (self.config.MARGIN * self.config.LEVERAGE) / current_price

            # Open short position
            order = self.exchange.create_order(
                symbol=self.config.SYMBOL,
                type='market',
                side='sell',
                amount=position_size,
                params={
                    'openType': 1,  # Isolated margin
                    'positionType': 2  # Short position
                }
            )

            # Set stop-loss
            stop_price = current_price * (1 + self.config.STOP_LOSS_PERCENT / 100)
            stop_order = self.exchange.create_order(
                symbol=self.config.SYMBOL,
                type='stop_market',
                side='buy',
                amount=position_size,
                params={
                    'stopPrice': stop_price,
                    'positionType': 2
                }
            )

            # Set take-profit
            take_profit_price = current_price * (1 - self.config.TAKE_PROFIT_PERCENT / 100)
            tp_order = self.exchange.create_order(
                symbol=self.config.SYMBOL,
                type='limit',
                side='buy',
                amount=position_size,
                price=take_profit_price,
                params={'positionType': 2}
            )

            order.update({
                'stop_loss_price': stop_price,
                'take_profit_price': take_profit_price
            })

            logger.info(f"Short opened: {order['id']} - {position_size:.4f} "
                       f"{self.config.SYMBOL.split('_')[0]} at {current_price:.2f} USDT")
            logger.info(f"Stop-loss: {stop_price:.2f} USDT | Take-profit: {take_profit_price:.2f} USDT")
            
            self.save_position(order)
            return True

        except Exception as e:
            logger.error(f"Failed to open short: {e}")
            return False

    def check_existing_position(self) -> bool:
        """Check if there's an open position with validation"""
        if not self.position_file.exists():
            return False

        try:
            with self.position_file.open('r') as f:
                position = json.load(f)
            
            positions = self.exchange.fetch_positions([self.config.SYMBOL])
            for pos in positions:
                if (pos['symbol'] == self.config.SYMBOL and 
                    pos['side'] == 'short' and 
                    float(pos['contracts']) > 0):
                    return True
            
            self.position_file.unlink()  # Clean up if no position exists
            return False
        except Exception as e:
            logger.error(f"Error checking position: {e}")
            return False

    def run(self) -> None:
        """Main execution loop with graceful shutdown"""
        logger.info(f"Short Bot started for {self.config.SYMBOL}")
        try:
            while True:
                if self.check_existing_position():
                    logger.info("Waiting for existing position to close")
                    time.sleep(3600)
                    continue

                next_purchase = self.get_next_purchase_time()
                sleep_seconds = (next_purchase - datetime.utcnow()).total_seconds()
                
                if sleep_seconds > 0:
                    logger.info(f"Next short at {next_purchase} UTC "
                               f"({int(sleep_seconds/3600)} hours)")
                    time.sleep(sleep_seconds)
                
                if self.open_short():
                    logger.info("Short position opened successfully")
                else:
                    logger.warning("Failed to open short, retrying next cycle")
                    time.sleep(self.config.RETRY_DELAY)

        except KeyboardInterrupt:
            logger.info("Bot stopped by user")
        except Exception as e:
            logger.error(f"Fatal error: {e}")
            sys.exit(1)

if __name__ == "__main__":
    try:
        bot = ShortBot()
        bot.run()
    except ValueError as e:
        logger.error(f"Configuration error: {e}")
        sys.exit(1)
    except Exception as e:
        logger.error(f"Startup error: {e}")
        sys.exit(1)
